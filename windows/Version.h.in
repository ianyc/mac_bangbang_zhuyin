#define BANGBANG_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define BANGBANG_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define BANGBANG_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define BANGBANG_VERSION_STRING "@PROJECT_VERSION@"

#endif
